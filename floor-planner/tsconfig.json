{
  "compilerOptions": {
    "types": ["cypress", "node"],
    "jsx": "react-jsx",
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "noEmit": false,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@floor-planner/utils/*": ["./src/utils/*"]
    }
  },
  "include": [
    "src",
    "cypress",
    "cypress/support/*.d.ts",
    "cypress/e2e/**/*.ts",
    "src/tests"
  ],
  "exclude": ["node_modules", "dist"]
}
