{
  "compilerOptions": {
    "types": ["cypress", "node"],
    // Make sure "jsx" is either "react" or "react-jsx"
    "jsx": "react-jsx",
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    // Ensures .tsx is recognized
    "allowJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src",
    "cypress",
    "cypress/support/*.d.ts",
    "cypress/e2e/**/*.ts",
    // Optionally ensure tests are included
    "src/tests"
  ],
  "exclude": ["node_modules", "dist"]
}